<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pt_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_pt_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="#94A3B8"
            android:includeFontPadding="false"
            android:text="–" />

        <TextView
            android:id="@+id/widget_pt_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#38BDF8"
            android:text="–" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/widget_pt_item0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_pt_item1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/widget_pt_item2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_pt_item3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/widget_pt_item4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_pt_item5" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_pt_l5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true"
                android:textSize="11sp" android:textColor="#94A3B8"
                android:includeFontPadding="false" android:text="–" />
            <TextView android:id="@+id/widget_pt_t5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#F1F5F9"
                android:includeFontPadding="false" android:text="–" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>