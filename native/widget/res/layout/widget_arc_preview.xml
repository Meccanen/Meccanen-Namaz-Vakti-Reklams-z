<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçici için statik "Vakit Halkası" önizlemesi: halka + altta
     6 sütunlu vakit adları ve saatleri. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gece"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#38BDF8"
        android:text="@string/widget_preview_city" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:src="@drawable/widget_arc_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:includeFontPadding="false"
                android:text="@string/widget_preview_maghrib" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:includeFontPadding="false"
                android:text="18:42" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_fajr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_sunrise_short" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_dhuhr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_asr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_maghrib" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_isha" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="05:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="07:08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="12:56" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="15:48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="18:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="20:12" />
    </LinearLayout>
</LinearLayout>
