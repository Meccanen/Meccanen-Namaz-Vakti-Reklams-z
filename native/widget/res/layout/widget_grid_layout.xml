<?xml version="1.0" encoding="utf-8"?>
<!-- Vakit Kartları widget'ı: sol-üst konum, sağ-üst kalan süre,
     altında 6 başlık kartı (İmsak..Yatsı), tek ayraç çizgisi ve
     her kartın altında ortalanmış vakit.
     NOT: kart zeminleri XML'de değil provider tarafından
     setBackgroundResource action'ıyla uygulanır (RemoteViews/Host uyumluluğu için
     kanıtlanmış desen; drawable 'card' görünümü widget_pt/arc ile aynı çalışır). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_grid_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_grid_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="start"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:textColor="#94A3B8"
            android:text="–" />

        <TextView
            android:id="@+id/widget_grid_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#38BDF8"
            android:text="–" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_grid_c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_grid_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_grid_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_grid_c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_grid_c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_grid_c5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/widget_grid_l5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F1F5F9"
                android:text="–" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_grid_t0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />

        <TextView
            android:id="@+id/widget_grid_t1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />

        <TextView
            android:id="@+id/widget_grid_t2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />

        <TextView
            android:id="@+id/widget_grid_t3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />

        <TextView
            android:id="@+id/widget_grid_t4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />

        <TextView
            android:id="@+id/widget_grid_t5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#F1F5F9"
            android:text="--:--" />
    </LinearLayout>
</LinearLayout>