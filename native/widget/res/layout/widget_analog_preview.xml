<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçici için statik "Analog Saat" önizlemesi: analog kadran,
     saniye ibresi ve altta 6 sütunlu vakit adları/saatleri. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gece"
    android:orientation="vertical"
    android:gravity="center_horizontal|center_vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#38BDF8"
        android:text="@string/widget_preview_city" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:src="@drawable/widget_analog_face" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:rotation="210"
            android:contentDescription=""
            android:src="@drawable/widget_analog_second_hand" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_fajr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_sunrise_short" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_dhuhr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_asr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_maghrib" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_isha" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="05:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="07:08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="12:56" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="15:48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="18:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="20:12" />
    </LinearLayout>
</LinearLayout>
