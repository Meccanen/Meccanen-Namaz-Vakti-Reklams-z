<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçici için statik "Saat & Takvim" önizlemesi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gece"
    android:orientation="vertical"
    android:gravity="center_horizontal|center_vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textColor="#38BDF8"
        android:text="@string/widget_preview_city" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:typeface="monospace"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:includeFontPadding="false"
        android:textColor="#F1F5F9"
        android:text="18:42" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="13sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="#94A3B8"
        android:text="@string/widget_preview_weekday" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="@string/widget_preview_gregorian" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:typeface="monospace"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="@string/widget_preview_greg_month" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="@string/widget_preview_hijri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:typeface="monospace"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#38BDF8"
                android:text="@string/widget_preview_hijri_month" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_fajr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_sunrise_short" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_dhuhr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_asr" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_maghrib" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="@string/widget_preview_isha" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="05:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="07:08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="12:56" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="15:48" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#38BDF8"
            android:includeFontPadding="false"
            android:text="18:42" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="#F1F5F9"
            android:includeFontPadding="false"
            android:text="20:12" />
    </LinearLayout>
</LinearLayout>
